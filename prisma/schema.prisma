// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Noticia {
    id        Int      @id @default(autoincrement())
    titulo      String
    resumo      String?
    conteudo_completo String?
    img         String?
    data     DateTime  @default(now())
    atualizadaEm DateTime @updatedAt
    categoria String? 
    publicada Boolean @default(false)
    destaque Boolean @default(false)

    @@index([data])
    @@index([publicada, destaque])
    @@map("noticia")
}

model Carreiras {
   id        Int      @id @default(autoincrement())
  nome     String
  descricao String?
  cursos_relacionados String[]
  profissoes String[]
  habilidades String[]
  img     String?
  salario_medio String?
  area String?
  criada DateTime  @default(now())
  atualizado DateTime @updatedAt

  @@map("carreiras")

   
}

model Dica {
  id       Int      @id @default(autoincrement())
  titulo   String
  descricao String?
  conteudo String?
  categoria String?
  img      String?
  urlFonte String?
  destaque Boolean @default(false)
  criada  DateTime @default(now())
  atualizada DateTime @updatedAt

  @@map("dica")
}

model Estagio {
  id       Int      @id @default(autoincrement())
  titulo   String
  empresa String?
  descricao String?
  requisitos String?
  cursos String[]
  modalidade String?
  bolsa_auxilio String?
  carga_horaria String?
  ativo Boolean @default(true)
  criada  DateTime @default(now())
  atualizada DateTime @updatedAt

  @@index([ativo])
  @@map("estagio")
}

model Simulado {
  id      Int      @id @default(autoincrement())
  titulo   String
  descricao String?
  disciplina String?
  questoes QuestaoSimulado[]
  tempo  Int?
  quantidade_questoes Int?
  publicado Boolean @default(false)
  criada  DateTime @default(now())
  atualizada DateTime @updatedAt

  @@map("simulado")
}


model QuestaoSimulado {
  id              Int      @id @default(autoincrement())
  simuladoId      Int
  enunciado       String
  imagem          String?
  alternativas    String[]
  respostaCorreta Int
  explicacao      String?
  ordem           Int      @default(0)

  simulado Simulado @relation(fields: [simuladoId], references: [id], onDelete: Cascade)

  @@map("questao_simulado")
}

model RespostaSimulado {
  id              Int      @id @default(autoincrement())
  nome_aluno      String?
  simuladoId      Int
  acertos        Int
  total_questoes   Int
  percentual  Float
  tempo_gasto     Int?
  realizado_em     DateTime @default(now())


  @@map("resposta_simulado")
  @@index([simuladoId])
}

model Video {
  id       Int      @id @default(autoincrement())
  titulo   String
  descricao String?
  url      String
  plataforma String?
  thumbnail String?
  disciplina String?
  duracao String?
  ordem Int @default(0)
  publicado Boolean @default(true)
  criada  DateTime @default(now())


  @@index([publicado, ordem])
  @@map("video")
}

model SobreNos {
  id     Int      @id @default(autoincrement())
  nomeProjeto String
  descricao String?
  objetivo String?
  membros String[]
  contatos String[]

  @@map("sobre_nos")
}

model MembroEquipe {
  id     Int      @id @default(autoincrement())
  nome   String
  funcao String?
  bio    String?
  foto  String?
  ordem Int 
  ativo Boolean @default(true)

  @@map("membro_equipe")
}

model Administrador {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  ativo   Boolean  @default(true)
  ultimoLogin DateTime?
  criadoEm DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("administrador")
}